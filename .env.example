# Athena AI Environment Configuration

# LLM Settings
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=hf.co/agentscope-ai/QwenPaw-Flash-4B-Q4_K_M:latest

# Ollama
OLLAMA_URL=http://localhost:11434

# LiteLLM (optional proxy)
LITELLM_URL=http://localhost:4000

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=athena_key

# Log level
LOG_LEVEL=INFO

# Obsidian Vault Path (optional)
# OBSIDIAN_VAULT_PATH=/home/jerry/Obsidian

# Joplin Settings (optional)
# JOPLIN_API_URL=http://localhost:41184
# JOPLIN_API_KEY=your_joplin_api_key

# Embedding Model
EMBEDDING_MODEL=nomic-embed-text:latest

# Gemini (optional)
# GOOGLE_API_KEY=your_google_api_key
# GEMINI_MODEL=gemini-pro

# Voice
VOICE_LANGUAGE=en
